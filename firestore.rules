rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Test connection
    match /test/connection {
      allow read: if true;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'do2738735@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Orders collection
    match /orders/{orderId} {
      allow create: if (
        isSignedIn() &&
        isValidId(orderId) &&
        incoming().keys().hasAll(['userId', 'playerId', 'gameId', 'gameName', 'packageId', 'packageName', 'price', 'status', 'paymentMethod', 'transactionId', 'createdAt']) &&
        incoming().keys().size() == 11 &&
        incoming().userId == request.auth.uid &&
        incoming().playerId is string && incoming().playerId.size() <= 100 &&
        incoming().gameId is string &&
        incoming().gameName is string &&
        incoming().packageId is string &&
        incoming().packageName is string &&
        incoming().price is number &&
        incoming().status in ['pending', 'processing', 'completed', 'failed', 'refunded'] &&
        incoming().paymentMethod in ['mpesa', 'emola', 'balance'] &&
        incoming().transactionId is string &&
        incoming().createdAt == request.time
      );
      // Allowing list for all authenticated users for the live feed, but strict filtering is assumed
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // 2. Presence collection
    match /presence/{userId} {
      allow write: if (
        isSignedIn() && 
        request.auth.uid == userId &&
        incoming().keys().hasAll(['lastSeen']) &&
        incoming().keys().size() == 1 &&
        incoming().lastSeen == request.time
      );
      allow read: if isSignedIn();
    }

    // 3. Games and Packages
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();

      match /packages/{packageId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // 4. Stats
    match /stats/{docId} {
      allow read: if true;
      allow write: if isAdmin(); 
    }

    // 5. Admin Security Config
    match /config/admin {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 6. Admin Audit Logs
    match /admin_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // 7. Bot Commands
    match /bot_commands/{cmdId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Configuration
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. User Profiles
    match /profiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && (
        incoming().keys().hasAll(['uid', 'email', 'displayName', 'balance', 'role', 'vipLevel', 'createdAt']) &&
        incoming().keys().size() == 7 &&
        incoming().uid == userId &&
        incoming().email == request.auth.token.email &&
        incoming().role == 'user' &&
        incoming().balance == 0 &&
        incoming().createdAt == request.time
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && (
          // Allow updating specific fields
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastPlayerId']) ||
          // Or allow full sync as long as protected fields aren't changed
          (
            incoming().role == existing().role &&
            incoming().balance == existing().balance &&
            incoming().uid == existing().uid &&
            incoming().email == existing().email
          )
        )) ||
        isAdmin()
      );
    }
  }
}
